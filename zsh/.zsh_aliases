# .zsh_aliases
# @author deng
# since 2024 2025 2026

# Directory listing aliases.
if (( $+commands[eza] )); then
  alias l.='eza -a'
  alias ls='eza -F --sort=type --icons=auto'
  alias ll='eza -aF --long --sort=type --icons=auto'
  alias lt4='eza -lT -L4 --icons'
else
  alias ls='ls -F --color=auto'
  alias ll='ls -alhF --color=auto'
fi

# Small command shortcuts.
alias ~='cd ~'
alias ..='cd ..'
alias c='clear'
alias ff='fastfetch'
alias vi='nvim'
alias vim='nvim'
alias gst='git status'
alias cfg='cd ~/.config'
alias 哈吉米='cat'

# Claude
alias cc='claude'
